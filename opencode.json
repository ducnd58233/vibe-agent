{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "instructions": [
    "AGENTS.md",
    ".ai-agents/ROUTER.md",
    ".ai-agents/skills/ROUTER.md",
    ".ai-agents/agents/ROUTER.md",
    ".ai-agents/commands/ROUTER.md",
    ".ai-agents/PERMISSIONS.md",
    ".vibe-agent/.ai-agents/ROUTER.md",
    ".vibe-agent/.ai-agents/skills/ROUTER.md",
    ".vibe-agent/.ai-agents/agents/ROUTER.md",
    ".vibe-agent/.ai-agents/commands/ROUTER.md",
    ".vibe-agent/.ai-agents/PERMISSIONS.md"
  ],
  "permission": {
    "edit": {
      "*": "ask",
      ".ai-agents/**": "allow",
      ".vibe-agent/.ai-agents/**": "allow",
      "scripts/**": "allow",
      ".vibe-agent/scripts/**": "allow",
      ".cursor/**": "allow",
      ".claude/**": "allow",
      "*.md": "allow"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "rm *": "deny",
      "git push --force*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "vibe-agent": {
      "type": "local",
      "command": [
        "vibe-agent",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  }
}
