**/*/.env
**/*/settings.local.json

# Generated by scripts/link-ai-agents.* — edit assets under .ai-agents/ only; run link after clone.
/.claude/skills/
/.claude/agents/
/.claude/commands/
/.cursor/skills/
/.cursor/commands/
/.opencode/agents/
/.opencode/commands/
/.agents/skills/
/.agents/commands/
/.codex/agents/
/.codex/prompts/
/.codex/commands/
/.codex/skills/
# Goal verification artifacts from /goal (local only; see .ai-agents/references/goal-verification-records.md)
# Canonical run state: .agent-state/runs/<date>/<slug>/<version>/. /tmp/ stays ignored
# so a leftover tree is not offered for commit.
/tmp/

# Workspace-local runtime state: cross-run memory database, caches, runtime logs.
# The WebFetch cache lives here too; it used to be one line per host directory.
/.agent-state/

# Legacy WebFetch cache location, written before the cache moved to
# .agent-state/. Still ignored so an existing checkout does not suddenly offer
# 56 cached pages for commit. Safe to delete by hand.
/.claude/sdd-cache/

# Python bytecode from the hook scripts.
__pycache__/
*.pyc

# Compiled runtime binaries and release archives.
# `make -C runtime build` writes to dist/. A bare `go build ./cmd` from
# runtime/ on Windows writes cmd.exe next to the package. A nested
# runtime/runtime/ appears when -o is a path relative to that module.
*.exe
*.exe~
/runtime/dist/
# Linters installed on demand by `make tools`, pinned per module, never committed.
/runtime/bin/
/runtime/vibe-agent
/runtime/vibe-agent.exe
/runtime/cmd.exe
/runtime/runtime/
/docs/

# Top-level /skills/ is sometimes generated by link scripts; canonical source is .ai-agents/skills/.
/skills/
