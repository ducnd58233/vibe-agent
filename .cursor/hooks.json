{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "vibe-agent hook session-start --client cursor"
      }
    ],
    "preToolUse": [
      {
        "matcher": "WebFetch",
        "command": "python3 .ai-agents/hooks/sdd-cache-pre.py"
      },
      {
        "matcher": "Write|Delete",
        "command": "vibe-agent hook pre-tool-use --client cursor"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "vibe-agent hook pre-tool-use --client cursor"
      }
    ],
    "postToolUse": [
      {
        "matcher": "WebFetch",
        "command": "python3 .ai-agents/hooks/sdd-cache-post.py"
      },
      {
        "matcher": "Shell|Write|Delete",
        "command": "vibe-agent hook post-tool-use --client cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "matcher": "Shell|Write|Delete",
        "command": "vibe-agent hook post-tool-use-failure --client cursor"
      }
    ],
    "subagentStop": [
      {
        "command": "vibe-agent hook subagent-stop --client cursor"
      }
    ],
    "stop": [
      {
        "command": "vibe-agent hook stop --client cursor"
      }
    ]
  }
}
