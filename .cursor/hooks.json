{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .ai-agents/hooks/session-start.py"
      }
    ],
    "preToolUse": [
      {
        "matcher": "WebFetch",
        "command": "python3 .ai-agents/hooks/sdd-cache-pre.py"
      },
      {
        "matcher": "Read",
        "command": "python3 .ai-agents/hooks/simplify-ignore.py"
      }
    ],
    "postToolUse": [
      {
        "matcher": "WebFetch",
        "command": "python3 .ai-agents/hooks/sdd-cache-post.py"
      },
      {
        "matcher": "Edit|Write",
        "command": "python3 .ai-agents/hooks/simplify-ignore.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .ai-agents/hooks/design-token-guard.py"
      },
      {
        "command": "python3 .ai-agents/hooks/ui-slop-guard.py"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .ai-agents/hooks/subagent-grounding-guard.py"
      }
    ],
    "stop": [
      {
        "command": "python3 .ai-agents/hooks/simplify-ignore.py"
      }
    ]
  }
}
