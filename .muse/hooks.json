      { "hooks": [ { "type": "command", "command": "vibe-agent hook user-prompt-submit --client muse" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "vibe-agent hook pre-tool-use --client muse" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "vibe-agent hook post-tool-use --client muse" } ] }
