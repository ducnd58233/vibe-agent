{
  "vibe-agent": {
    "PreInvocation": [
      {
        "hooks": [
          { "type": "command", "command": "vibe-agent hook user-prompt-submit --workspace \"/d/projects/vibe-agent\" --toolkit \"/d/projects/vibe-agent\" --client antigravity" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "vibe-agent hook pre-tool-use --workspace \"/d/projects/vibe-agent\" --toolkit \"/d/projects/vibe-agent\" --client antigravity" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "vibe-agent hook post-tool-use --workspace \"/d/projects/vibe-agent\" --toolkit \"/d/projects/vibe-agent\" --client antigravity" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "vibe-agent hook stop --workspace \"/d/projects/vibe-agent\" --toolkit \"/d/projects/vibe-agent\" --client antigravity" }
        ]
      }
    ]
  }
}
